# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ── Snowflake (dlt destination credentials) ──────────────────────────────────
# Account identifier format: <org>-<account> (e.g. myorg-myaccount)
DESTINATION__SNOWFLAKE__CREDENTIALS__HOST=
DESTINATION__SNOWFLAKE__CREDENTIALS__USERNAME=
DESTINATION__SNOWFLAKE__CREDENTIALS__PASSWORD=
DESTINATION__SNOWFLAKE__CREDENTIALS__DATABASE=
DESTINATION__SNOWFLAKE__CREDENTIALS__WAREHOUSE=
DESTINATION__SNOWFLAKE__CREDENTIALS__ROLE=

# ── NYC 311 / Socrata ────────────────────────────────────────────────────────
# Optional — without a token you hit the anonymous rate limit (~1 req/s)
SOCRATA_APP_TOKEN=

# Dataset config — defaults are fine for the standard NYC 311 dataset
NYC_311_DATASET_ID=erm2-nwe9
NYC_311_API_DOMAIN=data.cityofnewyork.us
NYC_311_PAGE_LIMIT=50000
NYC_311_OVERLAP_DAYS=3

# ── dlt pipeline ─────────────────────────────────────────────────────────────
NYC_311_DESTINATIONS=snowflake
NYC_311_DLT_TABLE_NAME=service_requests_dlt
NYC_311_DLT_SNOWFLAKE_DATASET=NYC_311

# ── dbt (transformation layer) ───────────────────────────────────────────────
# dbt runs locally inside the Airflow image (see dags/nyc_311_dbt_local.py).
# No extra credentials are needed: dbt/profiles.yml reuses the
# DESTINATION__SNOWFLAKE__CREDENTIALS__* vars above.
